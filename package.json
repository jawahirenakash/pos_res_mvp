    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
