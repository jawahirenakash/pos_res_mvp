# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
NODE_ENV=development

# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tabletap
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/tabletap?schema=public"

# Required. At least 32 random characters. The server refuses to boot without a real value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOKEN_TTL=8h

BUSINESS_NAME="TableTap Demo Restaurant"

# Leave empty to disable CORS (the UI is served from the same origin, so it is not needed).
# Comma-separated allowlist, e.g. CORS_ORIGINS=https://pos.example.com,https://admin.example.com
CORS_ORIGINS=
# Set to 1 only when running behind a reverse proxy or load balancer.
TRUST_PROXY=

# Coarse per-IP request cap per minute (flood guard). Raise it if many terminals
# share one NAT IP; strict login/per-user limits still apply on top.
RATE_LIMIT_GLOBAL=1200

# Optional. Shared rate limiting and response caching. Required only when you
# run more than one app instance (otherwise each instance limits/caches alone).
# Start the bundled Redis with:  docker compose --profile scale up -d
REDIS_URL=

# Demo seed account. Leave SEED_OWNER_PASSWORD blank to have the seeder generate one and print it.
SEED_OWNER_EMAIL=owner@tabletap.local
SEED_OWNER_PASSWORD=
